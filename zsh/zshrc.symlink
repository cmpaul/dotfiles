export DOTFILES="$HOME/.dotfiles"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Allow more open files than the OSX default of 256
if [ `ulimit -n` -lt 8192 ]; then
    ulimit -n 8192
fi

# unique values only in $PATH
typeset -U path PATH

function append_to_path {
  if [ -d "$1" ]; then
    path+=$1
  fi
}

function prepend_to_path {
  if [ -d "$1" ]; then
    path=($1 $path)
  fi
}

# don't confirm * in rm -rf
setopt RM_STAR_SILENT

# automatically enter directories without cd
setopt auto_cd

# history
export HISTFILE=~/.zhistory
export HISTSIZE=1000000
export SAVEHIST=1000000
setopt APPEND_HISTORY         # multiple sessions append to same history file
setopt HIST_IGNORE_ALL_DUPS   # when adding a new entry delete older duplicates
setopt HIST_IGNORE_DUPS       # don't add a new entry if it's an immediate duplicate
setopt INC_APPEND_HISTORY     # adds history incrementally to share it across sessions
setopt SHARE_HISTORY          # share history between sessions

# Setup zsh completions for homebrew formulas (from https://docs.brew.sh/Shell-Completion)
FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
autoload -Uz compinit
compinit

[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.localaliases" ]] && source "$HOME/.localaliases"

export GPG_TTY=$(tty)

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git macos python docker docker-compose celery aliases sudo history)

source $ZSH/oh-my-zsh.sh

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$(brew --prefix)/opt/nvm/nvm.sh" ] && \. "$(brew --prefix)/opt/nvm/nvm.sh"
[ -s "$(brew --prefix)/opt/nvm/etc/bash_completion.d/nvm" ] && \. "$(brew --prefix)/opt/nvm/etc/bash_completion.d/nvm"

# Google Cloud SDK (installed via `brew install --cask gcloud-cli`)
GCLOUD_SDK="$(brew --prefix)/share/google-cloud-sdk"
[ -f "$GCLOUD_SDK/path.zsh.inc" ] && source "$GCLOUD_SDK/path.zsh.inc"
[ -f "$GCLOUD_SDK/completion.zsh.inc" ] && source "$GCLOUD_SDK/completion.zsh.inc"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# uv env shim (present when uv is installed via standalone installer)
[ -s "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

export CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=1
