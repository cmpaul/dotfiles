#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.
export DOTFILES=$HOME/.dotfiles

# Don't show last login date
touch ~/.hushlogin

# Set OS X defaults. Applying them is disruptive (rebuilds the Spotlight
# index, restarts Finder/Dock/Terminal, needs sudo), so it only runs when
# explicitly requested:
#   DOTFILES_SETDEFAULTS=1 bin/dot
# or run bin/set-defaults directly.
if [ "$DOTFILES_SETDEFAULTS" = "1" ]; then
  $DOTFILES/osx/set-defaults.sh
else
  echo "› skipping macOS defaults (set DOTFILES_SETDEFAULTS=1 or run set-defaults to apply)"
fi

# Install homebrew
$DOTFILES/homebrew/install.sh 2>&1

# On a fresh machine brew was just installed by a child process and isn't on
# this shell's PATH yet
if ! command -v brew >/dev/null 2>&1; then
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# Upgrade & upgrade homebrew
echo "› brew update"
brew update
echo "› brew upgrade"
brew upgrade

# Install software
# I don't currently have any of these, so ignore for now
echo "› $DOTFILES/script/install.sh"

$DOTFILES/script/start.sh
