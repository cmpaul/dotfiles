export DOTFILES="$HOME/.dotfiles"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Allow more open files than the OSX default of 256
if [ `ulimit -n` -lt 8192 ]; then
    ulimit -n 8192
fi

# unique values only in $PATH
typeset -U path PATH

path+=("$DOTFILES/bin")

# don't confirm * in rm -rf
setopt RM_STAR_SILENT

# automatically enter directories without cd
setopt auto_cd

# history
export HISTFILE=~/.zhistory
export HISTSIZE=1000000
export SAVEHIST=1000000
setopt APPEND_HISTORY         # multiple sessions append to same history file
setopt HIST_IGNORE_ALL_DUPS   # when adding a new entry delete older duplicates
setopt HIST_IGNORE_DUPS       # don't add a new entry if it's an immediate duplicate
setopt INC_APPEND_HISTORY     # adds history incrementally to share it across sessions
setopt SHARE_HISTORY          # share history between sessions

# zsh completions for homebrew formulas (from https://docs.brew.sh/Shell-Completion)
# HOMEBREW_PREFIX is set by `brew shellenv` in ~/.zprofile; compinit itself runs
# once inside oh-my-zsh, so don't call it here.
FPATH="${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions:${FPATH}"

export GPG_TTY=$(tty)

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(macos python docker docker-compose celery aliases sudo history)

source $ZSH/oh-my-zsh.sh

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Personal aliases load after oh-my-zsh so they win over plugin definitions
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.localaliases" ]] && source "$HOME/.localaliases"

# mise — runtime version manager (Node, Python, etc.)
# reads .mise.toml, .tool-versions, .nvmrc, and .python-version files
eval "$(mise activate zsh)"

# Google Cloud SDK (installed via `brew install --cask gcloud-cli`)
GCLOUD_SDK="${HOMEBREW_PREFIX:-/opt/homebrew}/share/google-cloud-sdk"
[ -f "$GCLOUD_SDK/path.zsh.inc" ] && source "$GCLOUD_SDK/path.zsh.inc"
[ -f "$GCLOUD_SDK/completion.zsh.inc" ] && source "$GCLOUD_SDK/completion.zsh.inc"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# uv env shim (present when uv is installed via standalone installer)
[ -s "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Secrets live in 1Password — pull them into the environment only when needed,
# so no keys sit in plaintext on disk. The env var → 1Password mapping lives
# in zsh/secrets.conf. Signs in to 1Password first if the session doesn't
# already have a valid token.
export SECRETS_CONF="$DOTFILES/zsh/secrets.conf"

function load-secrets {
  local name ref val loaded=()

  if [[ ! -f "$SECRETS_CONF" ]]; then
    print -P "%F{red}✗ no secrets mapping at $SECRETS_CONF%f"
    return 1
  fi

  op whoami >/dev/null 2>&1 || eval "$(op signin)"

  while IFS='=' read -r name ref; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    if val="$(op read "$ref" 2>/dev/null)" && [[ -n "$val" ]]; then
      export "$name"="$val"
      loaded+=("$name")
    else
      print -P "%F{red}✗ failed to read $name from $ref%f"
    fi
  done < "$SECRETS_CONF"

  if (( ${#loaded} )); then
    print -P "%F{8} ╭─╮%f"
    print -P "%F{8}┌┴──┐%f %F{green}✓ secrets loaded%f %F{8}(${(j:, :)loaded})%f"
    print -P "%F{8}└───┘%f"
  fi
}

# Show a reminder once per session when any mapped secret isn't loaded. Runs
# after the first prompt renders so it doesn't trip p10k instant prompt's
# output check.
function _secrets_reminder {
  add-zsh-hook -d precmd _secrets_reminder
  local name ref
  [[ -f "$SECRETS_CONF" ]] || return 0
  while IFS='=' read -r name ref; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    if [[ -z "${(P)name}" ]]; then
      print -P "%F{8}  ╭─╮%f"
      print -P "%F{8} ┌┴─┴┐%f  %F{yellow}secrets not loaded%f"
      print -P "%F{8} │ ● │%f  run %F{cyan}load-secrets%f to sign in to 1Password and export API keys"
      print -P "%F{8} └───┘%f"
      return 0
    fi
  done < "$SECRETS_CONF"
}
# Offer to run `dot` when it hasn't run in 30+ days, once per session after
# the first prompt renders (a precmd would trip p10k instant prompt's output
# check if it ran during zshrc). `dot` stamps successful runs, including
# manual ones; declining snoozes the offer for a day so new tabs don't nag.
function _dot_reminder {
  add-zsh-hook -d precmd _dot_reminder

  local stamp_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  local now=$(date +%s) last=0 snoozed=0 reply
  [[ -r "$stamp_dir/dot-lastrun" ]] && last=$(<"$stamp_dir/dot-lastrun")
  [[ -r "$stamp_dir/dot-snooze" ]] && snoozed=$(<"$stamp_dir/dot-snooze")
  [[ "$last" == <-> ]] || last=0
  [[ "$snoozed" == <-> ]] || snoozed=0

  (( now - last < 30 * 86400 )) && return 0
  (( now - snoozed < 86400 )) && return 0

  if read -t 30 -k 1 "reply?  ⟳ dotfiles: dot hasn't run in 30+ days — run it now? [y/N] "; then
    print
    if [[ "$reply" == [yY] ]]; then
      # Absolute path: a bare `dot` resolves to graphviz's dot, which sorts
      # earlier in $PATH via homebrew
      "$DOTFILES/bin/dot"
    else
      mkdir -p "$stamp_dir"
      print "$now" > "$stamp_dir/dot-snooze"
    fi
  else
    # timed out with no answer — ask again next session
    print
  fi
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd _secrets_reminder
add-zsh-hook precmd _dot_reminder

export CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=1
