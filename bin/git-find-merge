#!/usr/bin/env bash
# Find the merge commit on the default branch for the given commit

set -o pipefail

if [ "$1" = "-h" ] || (( $# > 1 )); then
  echo "Find the merge commit for the given commit"
  echo ""
  echo "Usage: $(basename "${0}") [<sha>]"
  echo "  <sha>: defaults to HEAD"
  exit 1
fi

commit=$(git rev-parse "${1:-HEAD}") || exit 1
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
default_branch=${default_branch:-main}

# Already a merge commit?
git rev-parse "${commit}^2" &>/dev/null && echo "$commit" && exit 0

# Squash merge?
git show --summary "$commit" | grep -q "Merge pull request #" \
  && git show --summary "$commit" | grep -q "Squashed commit of the following:" \
  && echo "$commit" && exit 0

# Try GitHub API
merge=$(gh api "repos/:owner/:repo/commits/$commit/pulls" 2>/dev/null | jq -r '.[].merge_commit_sha' | head -1)
[ -n "$merge" ] && echo "$merge" && exit 0

# Manual ancestry search
merge=$(perl -ne 'print if ($seen{$_} .= @ARGV) =~ /10$/' \
  <(git rev-list --ancestry-path "${commit}..origin/${default_branch}") \
  <(git rev-list --first-parent "${commit}..origin/${default_branch}") | tail -n 1)
[ -n "$merge" ] && echo "$merge" && exit 0

echo "Unable to find merge commit for ${commit}" >&2
exit 1
