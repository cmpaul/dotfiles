#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.
export DOTFILES=$HOME/.dotfiles

# Don't show last login date
touch ~/.hushlogin

# Set OS X defaults (needs sudo; restarts Finder/Dock and friends)
$DOTFILES/osx/set-defaults.sh

# Install homebrew
$DOTFILES/homebrew/install.sh 2>&1

# On a fresh machine brew was just installed by a child process and isn't on
# this shell's PATH yet
if ! command -v brew >/dev/null 2>&1; then
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# Upgrade & upgrade homebrew
echo "› brew update"
brew update
echo "› brew upgrade"
brew upgrade

# Install software
# I don't currently have any of these, so ignore for now
echo "› $DOTFILES/script/install.sh"

# Stamp the successful run — the shell's monthly dot reminder checks this
# (see _dot_reminder in zsh/zshrc.symlink). No explicit exit: bootstrap
# sources this file, and an exit here would kill it.
$DOTFILES/script/start.sh && {
  STAMP_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  mkdir -p "$STAMP_DIR"
  date +%s > "$STAMP_DIR/dot-lastrun"
}
