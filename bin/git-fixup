#!/usr/bin/env sh

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  printf "\033[1mUSAGE\033[0m
   git fixup

\033[1mEXAMPLES\033[0m
   Create a fixup commit for a recent commit

      \$ git fixup

   Pass options through to \`git commit\` as you otherwise would

      \$ git fixup --allow-empty --verbose
"
  exit 0
fi

if ! command -v fzf > /dev/null; then
  echo "Installing fzf..." && brew install fzf || exit 1
fi

commit=$(git log --oneline --grep="^fixup" --invert-grep | fzf | cut -f1 -d' ')
[ -z "$commit" ] && exit 1
git commit --fixup="$commit" "$@"
