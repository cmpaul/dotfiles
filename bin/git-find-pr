#!/usr/bin/env bash
# Find the PR URL for the given commit (defaults to HEAD)

set -o pipefail

if [ "$1" = "-h" ]; then
  echo "Find and open the PR for the given commit"
  echo ""
  echo "Usage: $(basename "${0}") [<sha>]"
  echo "  <sha>: defaults to HEAD"
  exit 0
fi

commit=$(git rev-parse "${1:-HEAD}") || exit 1

url=$(gh api "repos/:owner/:repo/commits/$commit/pulls" 2>/dev/null | jq -r '.[].html_url' | head -1)
if [ -n "$url" ]; then
  echo "$url"
  open "$url"
  exit 0
fi

# Fallback: check merge commit message for PR number
merge=$(git-find-merge "$commit" 2>/dev/null)
if [ -n "$merge" ]; then
  pr=$(git log -n1 "$merge" 2>/dev/null | grep -oE '#[0-9]+' | head -1 | tr -d '#')
  if [ -n "$pr" ]; then
    url=$(gh browse --no-browser 2>/dev/null)/pull/$pr
    echo "$url"
    open "$url"
    exit 0
  fi
fi

echo "No PR found for $commit" >&2
exit 1
