[alias]
	c          = commit -m
	a          = add
	di         = diff
	dic        = diff --cached
	pl         = pull
	ps         = push
	plre       = pull --rebase
	s          = status
	st         = status
	out        = log origin..HEAD
	ci         = commit
	co         = checkout
	cp         = cherry-pick
	b          = branch
	changed    = diff --name-status -r
	add-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"
	au         = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"
	ch         = diff --name-status -r
	cosu       = !sh -c 'git checkout $0 && git submodule update --init'
	ignored    = "!git ls-files --others --exclude-standard"
	lg         = log --all --graph --abbrev-commit --date=relative --pretty=format:'%C(bold blue)%h - %C(reset)%C(green)(%ar)%C(reset) - %s %C(dim)- %an%C(reset)%C(yellow)%d'
	lgb        = log --graph --abbrev-commit --date=relative --pretty=format:'%C(bold blue)%h - %C(reset)%C(green)(%ar)%C(reset) - %s %C(dim)- %an%C(reset)%C(yellow)%d'
	whatis     = show -s --pretty='tformat:%h (%s, %ad)' --date=short
	touchdown  = merge --no-ff
	integrate  = merge --no-ff
	td         = merge --no-ff
	lastauthor = log -1 --format='%Cgreen%an <%ae>'
	reauthor   = commit --amend --reset-author -C HEAD
	publish    = push -u
	tree       = log --graph --decorate --pretty=oneline --abbrev-commit
	hist       = log --pretty=format:\"%C(yellow)%h %ad%Creset | %s%C(bold red)%d%Creset [%C(bold blue)%an%Creset]\" --graph --date=short
	pf         = push --force-with-lease
	nit        = commit --amend --no-edit
	praise     = blame
	git        = !exec git
	lb         = branch -v --sort=committerdate
	count      = !git shortlog -sn
	cleanup    = !git gc && $DOTFILES/bin/git-prune
	cmp        = !$DOTFILES/bin/git-cmp
	cpbranch   = !git branch --show-current | pbcopy
	credit     = !$DOTFILES/bin/git-credit
	nuke       = !$DOTFILES/bin/git-nuke
	promote    = !$DOTFILES/bin/git-promote
	tidy-up    = !$DOTFILES/bin/git-tidy-up
	track      = !$DOTFILES/bin/git-track
	undo       = !$DOTFILES/bin/git-undo
	up         = !$DOTFILES/bin/git-up
	wtf        = !$DOTFILES/bin/git-wtf
	fixup      = "!git add . && git commit --fixup=${1:-$(git rev-parse HEAD)} && GIT_EDITOR=true git rebase --interactive --autosquash ${1:-$(git rev-parse HEAD~2)}~1"
[core]
        excludesfile = ~/.gitignore
        editor = vim
        pager = delta
        # Helpful for large repositories
        fsmonitor = true
	untrackedcache = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[apply]
        whitespace = nowarn
[push]
	default = current
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	renames = true
	indentHeuristic = on
	colorMoved = default
[branch]
	autosetupmerge = true
	sort = -committerdate
[rebase]
	autosquash = true
	autostash = true
[merge]
	summary = true
	conflictstyle = zdiff3
[help]
        autocorrect = 1
[commit]
	gpgsign = true
	verbose = true
	template = ~/.gitmessage
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
[rerere]
	enabled = 1
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[log]
	mailmap = true
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
[tag]
	gpgSign = true
